void setup()
{
  uint16_t ID = tft.readID();
  tft.begin(ID);
  tft.setRotation(1);
  tft.fillScreen(0x0000);

  tft.drawRGBBitmap(0, 0, image, IMG_W, IMG_H);
}

void loop(){
  delay(5000);

  for (x = 0; x <= 48; x++) {
    tft.drawFastVLine(0+x, 0, 320, 0x0000);
    tft.drawFastVLine(48+x, 0, 320, 0x0000);
    tft.drawFastVLine(96+x, 0, 320, 0x0000);
    tft.drawFastVLine(144+x, 0, 320, 0x0000);
    tft.drawFastVLine(192+x, 0, 320, 0x0000);
    tft.drawFastVLine(240+x, 0, 320, 0x0000);
    tft.drawFastVLine(288+x, 0, 320, 0x0000);
    tft.drawFastVLine(336+x, 0, 320, 0x0000);
    tft.drawFastVLine(384+x, 0, 320, 0x0000);
    tft.drawFastVLine(432+x, 0, 320, 0x0000);
    delay(100);
  }

  tft.drawRGBBitmap(0, 0, image, IMG_W, IMG_H);  
}